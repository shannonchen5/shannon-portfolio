# No environment variables are required to run the site locally.
# The contact form sends mail only after these are set:

# Resend API key — https://resend.com
RESEND_API_KEY=

# Verified sender, for example: Shannon Chen <hello@yourdomain.com>
CONTACT_FROM_EMAIL=

# Inbox that receives contact-form messages. Defaults to the address in content/site.json.
CONTACT_TO_EMAIL=
